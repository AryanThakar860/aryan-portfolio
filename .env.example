# ==============================================================================
# SHREEJI SAFFRON — ENVIRONMENT CONFIGURATION
# Copy to .env and configure for your deployment environment
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Database Path (defaults to ./data/saffron.db if unset)
DATABASE_PATH=./data/saffron.db

# Admin Secret Key for Protected Endpoints (e.g. GET /api/inquiries)
ADMIN_API_KEY=shreeji_secret_admin_key_2026

# Security & CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Outbound SMTP Email Configuration for Real Delivery
# If omitted or invalid, submissions are reliably persisted in SQLite database.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=concierge@shreejisaffron.in
